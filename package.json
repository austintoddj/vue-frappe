{
  "name": "vue-frappe",
  "version": "2.0.0",
  "description": "Vue 3 component wrapper for Frappe Charts — typed, tested, and tree-shakeable",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "frappe",
    "frappe-charts",
    "charts",
    "graph",
    "svg",
    "typescript",
    "component"
  ],
  "homepage": "https://github.com/austintoddj/vue-frappe#readme",
  "bugs": {
    "url": "https://github.com/austintoddj/vue-frappe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austintoddj/vue-frappe.git"
  },
  "author": {
    "name": "Todd Austin",
    "email": "austin.todd.j@gmail.com",
    "url": "https://toddaustin.me"
  },
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.4",
  "files": [
    "dist",
    "license",
    "readme.md"
  ],
  "main": "./dist/vue-frappe.cjs",
  "module": "./dist/vue-frappe.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-frappe.js",
      "require": "./dist/vue-frappe.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "preflight": "bash bin/preflight.sh",
    "prepublishOnly": "pnpm run build && pnpm run test && pnpm run size",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "frappe-charts": "^1.6.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.2.0",
    "frappe-charts": "^1.6.2",
    "globals": "^16.2.0",
    "happy-dom": "^17.6.3",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.13.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.3",
    "vue": "^3.5.16",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/vue-frappe.js",
      "limit": "8 kB"
    }
  ]
}
