{
  "name": "vue-frappe",
  "version": "2.0.0",
  "description": "Vue 3 component wrapper for Frappe Charts — typed, tested, and tree-shakeable",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "frappe",
    "frappe-charts",
    "charts",
    "graph",
    "svg",
    "typescript",
    "component"
  ],
  "homepage": "https://github.com/austintoddj/vue-frappe#readme",
  "bugs": {
    "url": "https://github.com/austintoddj/vue-frappe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austintoddj/vue-frappe.git"
  },
  "author": {
    "name": "Todd Austin",
    "email": "austin.todd.j@gmail.com",
    "url": "https://toddaustin.me"
  },
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "license",
    "readme.md"
  ],
  "main": "./dist/vue-frappe.cjs",
  "module": "./dist/vue-frappe.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-frappe.js",
      "require": "./dist/vue-frappe.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "preflight": "bash bin/preflight.sh",
    "prepublishOnly": "npm run build && npm run test && npm run size",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "frappe-charts": "^1.6.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.13",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/language-core": "^3.3.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "frappe-charts": "^1.6.2",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^13.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/vue-frappe.js",
      "limit": "8 kB"
    }
  ]
}
